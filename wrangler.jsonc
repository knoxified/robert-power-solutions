{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robert-power-solutions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker handles pages (so each gets its own SEO tags and unknown URLs return a real 404);
    // hashed JS/CSS and images are served straight from static assets without invoking the Worker.
    // The admin path must match ADMIN in worker/index.ts.
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/robots.txt"]
  },
  // Free key-value storage. Wrangler creates the namespace automatically on first deploy.
  "kv_namespaces": [{ "binding": "MEDIA" }]
}
