{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robert-power-solutions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is served straight from static assets.
    // The admin path must match ADMIN in worker/index.ts.
    "run_worker_first": ["/api/*", "/media/*", "/sitemap.xml", "/blog/*", "/robert-studio-9k4x", "/robert-studio-9k4x/*"]
  },
  // Free key-value storage. Wrangler creates the namespace automatically on first deploy.
  "kv_namespaces": [{ "binding": "MEDIA" }]
}
